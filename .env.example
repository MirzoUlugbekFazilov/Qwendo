# ───────────────────────────────────────────────────────────────
# Qwendo environment
# Copy to .env and fill in the secrets. Never commit .env.
# ───────────────────────────────────────────────────────────────

# Development Supabase instance (match web/.env.local)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Server-side only. Dashboard → Project Settings → API Keys → service_role.
# This key bypasses RLS: it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-side source credentials
TICKETMASTER_API_KEY=
# For local Brave searches, export this key into the worker process.
BRAVE_SEARCH_API_KEY=

# ── API ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared public cities eligible for discovery gap queries.
DEFAULT_CITIES=London
# Default Ticketmaster discovery window, in days.
INGEST_LOOKAHEAD_DAYS=120
# Optional deterministic ranker weights (relative values).
RANKING_WEIGHTS='{"topical":40,"experience":25,"location":15,"timing":10,"budget":10}'
# Optional network timeout (seconds)
REQUEST_TIMEOUT_SECONDS=30
