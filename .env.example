# ───────────────────────────────────────────────────────────────
# Qwendo environment
# Copy to .env and fill in the secrets. Never commit .env.
# ───────────────────────────────────────────────────────────────

# ── Supabase (project: Qwendo / hfpnbzadymxttjnilkkz) ──────────
SUPABASE_URL=https://hfpnbzadymxttjnilkkz.supabase.co
SUPABASE_ANON_KEY=sb_publishable_eSOHgP5vpIDo5lhiL3ou5Q_CUBSMF3i

# Server-side only. Dashboard → Project Settings → API Keys → service_role.
# This key bypasses RLS: it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Embeddings ─────────────────────────────────────────────────
# "local"  = deterministic hashed bag-of-words, zero cost, no API key (default)
# "openai" = text-embedding-3-small, far better semantics, needs OPENAI_API_KEY
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=1536
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Scraper credentials (all optional; each source degrades gracefully) ──
# Ticketmaster Discovery API: https://developer.ticketmaster.com (free key)
TICKETMASTER_API_KEY=
# Eventbrite: public listing pages are parsed; a token unlocks richer detail calls
EVENTBRITE_TOKEN=
# Luma: public discovery endpoints need no key
LUMA_API_KEY=

# ── API ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared secret required by POST /admin/* (generate: openssl rand -hex 32)
INGEST_TOKEN=change-me-in-production

# ── Ingestion defaults ─────────────────────────────────────────
DEFAULT_CITIES=London,Manchester,Birmingham
INGEST_LOOKAHEAD_DAYS=120
REQUEST_TIMEOUT_SECONDS=30
MAX_EVENTS_PER_SOURCE=400
